# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=taskflow

# Authentication
# demo = sofort lokal nutzbar, oidc = externer OpenID-Connect-Provider
AUTH_MODE=demo
DEMO_USER=portfolio-user

# Nur bei AUTH_MODE=oidc erforderlich:
OIDC_ISSUER=https://identity.example.com/realms/taskflow
OIDC_CLIENT_ID=taskflow-web
OIDC_CLIENT_SECRET=replace-me
