# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=taskflow

# Authentication
# demo = ready for local development, oidc = external OpenID Connect provider
AUTH_MODE=demo
DEMO_USER=portfolio-user

# Required only when AUTH_MODE=oidc:
OIDC_ISSUER=https://identity.example.com/realms/taskflow
OIDC_CLIENT_ID=taskflow-web
OIDC_CLIENT_SECRET=replace-me
